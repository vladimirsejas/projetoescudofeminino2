import sqlite3
import pandas as pd

# =====================================
# CONEXÃO
# =====================================

BANCO = r"C:\projetoescudofeminino\banco\escudo_feminino.db"

conn = sqlite3.connect(BANCO)

# =====================================
# LEITURA
# =====================================

df = pd.read_sql("""
SELECT *
FROM priorizacao_executiva
ORDER BY pontuacao_final DESC
""", conn)

# =====================================
# PRINCIPAL PRIORIDADE
# =====================================

principal = df.iloc[0]

# =====================================
# TOP 3
# =====================================

top3 = df.head(3)

# =====================================
# TEXTO EXECUTIVO
# =====================================

relatorio = f"""
RELATÓRIO EXECUTIVO - ESCUDO FEMININO

Principal prioridade epidemiológica:

{principal['tipo_cancer']}

Pontuação final:
{principal['pontuacao_final']:.2f}

Classificação:
{principal['nivel_prioridade']}

----------------------------------------

TOP 3 PRIORIDADES

1º {top3.iloc[0]['tipo_cancer']}
   Score: {top3.iloc[0]['pontuacao_final']:.2f}

2º {top3.iloc[1]['tipo_cancer']}
   Score: {top3.iloc[1]['pontuacao_final']:.2f}

3º {top3.iloc[2]['tipo_cancer']}
   Score: {top3.iloc[2]['pontuacao_final']:.2f}

----------------------------------------

ANÁLISE AUTOMÁTICA

O câncer de maior prioridade atualmente é
{principal['tipo_cancer']}.

Este resultado foi obtido pela combinação
dos indicadores epidemiológicos,
desvios em relação à tendência estadual
e análise de anomalias.

A classificação final foi
{principal['nivel_prioridade']}.

Recomenda-se acompanhamento contínuo
dos grupos classificados com maior
prioridade epidemiológica.
"""

# =====================================
# EXIBIR
# =====================================

print(relatorio)

# =====================================
# SALVAR TXT
# =====================================

with open(
    "relatorio_executivo.txt",
    "w",
    encoding="utf-8"
) as arquivo:

    arquivo.write(relatorio)

print("\nArquivo relatorio_executivo.txt criado com sucesso.")

conn.close()